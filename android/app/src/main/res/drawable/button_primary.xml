<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#50635A" />
            <corners android:radius="12dp" />
            <padding android:left="14dp" android:top="11dp" android:right="14dp" android:bottom="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#70DCA1" android:endColor="#BAF7CF" />
            <corners android:radius="12dp" />
            <padding android:left="14dp" android:top="11dp" android:right="14dp" android:bottom="11dp" />
        </shape>
    </item>
</selector>
