<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#08121D" />
            <stroke android:width="2dp" android:color="@color/sky_blue" />
            <corners android:radius="12dp" />
            <padding android:left="13dp" android:top="11dp" android:right="13dp" android:bottom="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08121D" />
            <stroke android:width="1dp" android:color="#304255" />
            <corners android:radius="12dp" />
            <padding android:left="14dp" android:top="12dp" android:right="14dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
